# Copy to .env and fill in. On the server: chmod 600 .env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ZOHO_SMTP_USER=          # full Zoho Mail address
ZOHO_SMTP_APP_PASSWORD=  # Zoho app-specific password, NOT the login password
REPORT_TO=               # recipient address (my Zoho inbox)
# Optional: only needed when sources.aggregator.enabled is true
SERPAPI_API_KEY=
